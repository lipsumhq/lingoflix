{
  "name": "lingoflix-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "next typegen && tsc --noEmit",
    "db:make": "kysely migrate make",
    "db:migrate": "kysely migrate latest",
    "db:migrate:local": "kysely migrate latest -e local",
    "db:list": "kysely migrate list"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@vercel/functions": "3.9.11",
    "kysely": "0.29.6",
    "next": "16.4.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "kysely-ctl": "0.21.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
