{
  "name": "lingoflix-extension",
  "version": "1.0.0",
  "description": "Explains Netflix subtitles line by line with your own Claude or OpenAI key, and keeps a Study Log.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jay Cho <jaycho1214@gmail.com>",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "LINGOFLIX_STORE=1 wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fontsource-variable/nunito": "5.3.0",
    "lucide-react": "1.48.0",
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
